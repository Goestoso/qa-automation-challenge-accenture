{
  "name": "qa-automation-challenge-accenture",
  "version": "1.0.0",
  "private": true,
  "description": "Automação do desafio de QA com TypeScript, Mocha, Chai e Selenium WebDriver.",
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && npm run test:api",
    "test:api": "mocha --require ts-node/register --require tsconfig-paths/register \"tests/apis/**/*.spec.ts\"",
    "test:ui": "mocha --require ts-node/register --require tsconfig-paths/register \"tests/ui/**/*.spec.ts\"",
    "test:all": "npm run build && npm run test:api && npm run test:ui",
    "test:bdd": "cucumber-js --require-module ts-node/register --require-module tsconfig-paths/register --require tests/bdd/steps/**/*.ts --format progress"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "selenium-webdriver": "^4.27.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@types/selenium-webdriver": "^4.1.28",
    "chai": "^4.5.0",
    "mocha": "^11.0.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
